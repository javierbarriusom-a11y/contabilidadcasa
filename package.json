{
  "name": "finanzas-casa-def",
  "version": "0.10.0",
  "private": true,
  "description": "Dashboard financiero personal con motor canónico, conciliación y pruebas de regresión.",
  "scripts": {
    "test": "node --test tests/*.test.*",
    "build:demo": "node tools/build-public-demo-data.mjs",
    "golden:datasets": "node tools/build-golden-datasets.mjs",
    "golden:debt-cases": "node tools/build-golden-debt-cases.mjs",
    "golden:combined-cases": "node tools/build-golden-combined-cases.mjs",
    "build:site": "npm run build:demo && node tools/build-public-site.mjs",
    "test:privacy": "node tools/check-public-privacy.mjs",
    "test:smoke": "node tools/smoke-public.mjs",
    "audit:escenarios": "node tools/audit-escenarios.mjs",
    "test:a11y": "node tools/check-accessibility.mjs",
    "test:performance": "node tools/check-performance.mjs",
    "test:performance-lh": "node tools/check-lighthouse-budget.mjs",
    "test:visual": "playwright test --project=desktop --project=mobile",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y-axe": "playwright test --project=a11y",
    "backend:start": "node backend/server.mjs",
    "verify": "npm test && npm run test:a11y && npm run test:performance && npm run build:site && npm run test:privacy && npm run test:smoke",
    "baseline:capture": "node tools/capture-baseline.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "esbuild": "^0.28.2"
  }
}
